# Public URL of the app, used in password reset emails (required in production)
# APP_URL="https://tanaw.example.com"

# Email (Forgot password) - sent from the system Gmail account.
# SMTP_PASS is a 16-character Google App Password for that account (needs
# 2-Step Verification): https://myaccount.google.com/apppasswords
# Leave SMTP_HOST empty in development to print the reset link to the server
# terminal instead of emailing it.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="qcutanaw.noreply@gmail.com"
SMTP_PASS=""
MAIL_FROM="QCU TANAW <qcutanaw.noreply@gmail.com>"

