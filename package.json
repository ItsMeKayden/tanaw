{
  "name": "tanaw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:pull": "prisma db pull --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed:demo": "prisma db seed --config prisma7.config.ts -- --demo",
    "db:seed:reset-demo": "prisma db seed --config prisma7.config.ts -- --reset-demo --demo",
    "db:seed:demo-data": "tsx prisma/seeds/demo-data.ts",
    "db:seed:demo-exams": "tsx prisma/seeds/demo-exams.ts",
    "db:setup": "npm run db:migrate && npm run db:generate && npm run db:seed",
    "archive:purge": "tsx scripts/purge-archive.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
