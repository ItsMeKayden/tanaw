
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PRESIDENT
  ADMISSION
  REGISTRAR
  GUIDANCE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role UserRole @default(ADMISSION)
  isActive     Boolean  @default(true)
  emailVerified DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
