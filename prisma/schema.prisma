generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  PRESIDENT
  ADMISSION
  REGISTRAR
  GUIDANCE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(ADMISSION)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model tbl_admission_cycle {
  cycle_id                  Int                         @id @default(autoincrement())
  school_year               String                      @db.VarChar(50)
  start_date                DateTime?                   @db.Date
  end_date                  DateTime?                   @db.Date
  is_active                 Boolean?                    @default(true)
  tbl_application           tbl_application[]
  tbl_exam                  tbl_exam[]
  tbl_passing_score_setting tbl_passing_score_setting[]
  tbl_quota                 tbl_quota[]
}

model tbl_admission_stage {
  stage_id                  Int                         @id @default(autoincrement())
  stage_name                String                      @db.VarChar(100)
  stage_order               Int
  tbl_application           tbl_application[]
  tbl_application_stage_log tbl_application_stage_log[]
}

model tbl_applicant {
  applicant_id     Int               @id @default(autoincrement())
  last_name        String            @db.VarChar(100)
  first_name       String            @db.VarChar(100)
  middle_name      String?           @db.VarChar(100)
  suffix           String?           @db.VarChar(20)
  sex              String?           @db.VarChar(20)
  birth_date       DateTime?         @db.Date
  email            String?           @db.VarChar(150)
  mobile_no        String?           @db.VarChar(50)
  // Archived applicants are hidden everywhere except Archive History. They can
  // be recovered; after a year in the archive they are permanently deleted.
  archived_at      DateTime?         @db.Timestamp(6)
  archived_by      Int?
  tbl_application  tbl_application[]
  archived_by_user tbl_user_account? @relation("applicant_archived_by", fields: [archived_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([archived_at])
}

model tbl_application {
  application_id             Int                         @id @default(autoincrement())
  applicant_id               Int?
  school_id                  Int?
  barangay_id                Int?
  branch_id                  Int?
  program_id                 Int?
  program_choice_2_id        Int?
  program_choice_3_id        Int?
  cycle_id                   Int?
  current_stage_id           Int?
  application_no             String                      @unique @db.VarChar(50)
  application_date           DateTime                    @db.Date
  tbl_applicant              tbl_applicant?              @relation(fields: [applicant_id], references: [applicant_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_barangay               tbl_barangay?               @relation(fields: [barangay_id], references: [barangay_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_branch                 tbl_branch?                 @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_admission_stage        tbl_admission_stage?        @relation(fields: [current_stage_id], references: [stage_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_admission_cycle        tbl_admission_cycle?        @relation(fields: [cycle_id], references: [cycle_id], onDelete: NoAction, onUpdate: NoAction)
  // program_id is the 1st choice; 2nd and 3rd choices are optional.
  tbl_program                tbl_program?                @relation("application_program", fields: [program_id], references: [program_id], onDelete: NoAction, onUpdate: NoAction)
  program_choice_2           tbl_program?                @relation("application_program_choice_2", fields: [program_choice_2_id], references: [program_id], onDelete: SetNull, onUpdate: NoAction)
  program_choice_3           tbl_program?                @relation("application_program_choice_3", fields: [program_choice_3_id], references: [program_id], onDelete: SetNull, onUpdate: NoAction)
  tbl_school                 tbl_school?                 @relation(fields: [school_id], references: [school_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_application_stage_log  tbl_application_stage_log[]
  tbl_course_recommendation  tbl_course_recommendation[]
  tbl_exam_result            tbl_exam_result[]
  tbl_application_document   tbl_application_document[]
  tbl_exam_session_applicant tbl_exam_session_applicant?
}

model tbl_application_stage_log {
  log_id              Int                  @id @default(autoincrement())
  application_id      Int?
  changed_by          Int?
  stage_id            Int?
  changed_at          DateTime?            @default(now()) @db.Timestamp(6)
  remarks             String?
  tbl_application     tbl_application?     @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_user_account    tbl_user_account?    @relation(fields: [changed_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)
  tbl_admission_stage tbl_admission_stage? @relation(fields: [stage_id], references: [stage_id], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_barangay {
  barangay_id      Int               @id @default(autoincrement())
  district_id      Int?
  barangay_name    String            @db.VarChar(100)
  boundary_geojson String?
  tbl_application  tbl_application[]
  tbl_district     tbl_district?     @relation(fields: [district_id], references: [district_id], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_branch {
  branch_id       Int               @id @default(autoincrement())
  branch_code     String            @db.VarChar(50)
  branch_name     String            @db.VarChar(100)
  is_active       Boolean?          @default(true)
  tbl_application tbl_application[]
  tbl_quota       tbl_quota[]
}

model tbl_competency {
  competency_id          Int                      @id @default(autoincrement())
  competency_name        String                   @db.VarChar(150)
  subject_area           String?                  @db.VarChar(100)
  description            String?
  tbl_exam_question      tbl_exam_question[]
  tbl_program_competency tbl_program_competency[]
  tbl_exam_subject_score tbl_exam_subject_score[]
}

model tbl_course_recommendation {
  application_id       Int
  program_id           Int
  compatibility_score  Decimal?        @db.Decimal(5, 2)
  rank_no              Int?
  generated_at         DateTime?       @default(now()) @db.Timestamp(6)
  // Competencies whose score is below this course's subject minimum (advisory).
  unmet_competency_ids Int[]           @default([])
  tbl_application      tbl_application @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_program          tbl_program     @relation(fields: [program_id], references: [program_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([application_id, program_id])
}

model tbl_district {
  district_id      Int            @id @default(autoincrement())
  district_name    String         @db.VarChar(100)
  boundary_geojson String?
  tbl_barangay     tbl_barangay[]
}

model tbl_exam {
  exam_id             Int                  @id @default(autoincrement())
  cycle_id            Int?
  exam_name           String               @db.VarChar(150)
  exam_date           DateTime?            @db.Date
  total_items         Int?
  max_score           Int?
  tbl_admission_cycle tbl_admission_cycle? @relation(fields: [cycle_id], references: [cycle_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_exam_question   tbl_exam_question[]
  tbl_exam_result     tbl_exam_result[]
  tbl_exam_session    tbl_exam_session[]
}

model tbl_exam_question {
  question_id           Int                     @id @default(autoincrement())
  exam_id               Int?
  competency_id         Int?
  question_no           Int
  correct_answer        String                  @db.VarChar(255)
  points                Int
  tbl_competency        tbl_competency?         @relation(fields: [competency_id], references: [competency_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_exam              tbl_exam?               @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_question_response tbl_question_response[]
}

model tbl_exam_result {
  result_id              Int                      @id @default(autoincrement())
  application_id         Int?
  exam_id                Int?
  import_id              Int?
  raw_score              Int?
  percentage             Decimal?                 @db.Decimal(5, 2)
  result_status          String?                  @db.VarChar(50)
  tbl_application        tbl_application?         @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_exam               tbl_exam?                @relation(fields: [exam_id], references: [exam_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_import_batch       tbl_import_batch?        @relation(fields: [import_id], references: [import_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_question_response  tbl_question_response[]
  tbl_exam_subject_score tbl_exam_subject_score[]
}

model tbl_import_batch {
  import_id        Int               @id @default(autoincrement())
  imported_by      Int?
  file_name        String            @db.VarChar(255)
  imported_at      DateTime?         @default(now()) @db.Timestamp(6)
  total_records    Int?
  status           String?           @db.VarChar(50)
  tbl_exam_result  tbl_exam_result[]
  tbl_user_account tbl_user_account? @relation(fields: [imported_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_passing_score_setting {
  setting_id          Int                  @id @default(autoincrement())
  cycle_id            Int?
  updated_by          Int?
  criteria_type       String?              @db.VarChar(100)
  passing_value       Decimal?             @db.Decimal(10, 2)
  target_pass_rate    Decimal?             @db.Decimal(5, 4)
  effective_date      DateTime?            @db.Date
  tbl_admission_cycle tbl_admission_cycle? @relation(fields: [cycle_id], references: [cycle_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_user_account    tbl_user_account?    @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_permission {
  permission_id       Int                   @id @default(autoincrement())
  permission_code     String                @unique @db.VarChar(100)
  module_name         String                @db.VarChar(100)
  description         String?
  tbl_role_permission tbl_role_permission[]
}

model tbl_program {
  program_id                Int                         @id @default(autoincrement())
  program_code              String                      @db.VarChar(50)
  program_name              String                      @db.VarChar(150)
  is_active                 Boolean?                    @default(true)
  // Minimum course match (%) for the preferred course to count as "Compatible";
  // also the score required on each competency the course weighs.
  min_match                 Decimal                     @default(70) @db.Decimal(5, 2)
  tbl_application           tbl_application[]           @relation("application_program")
  choice_2_applications     tbl_application[]           @relation("application_program_choice_2")
  choice_3_applications     tbl_application[]           @relation("application_program_choice_3")
  tbl_course_recommendation tbl_course_recommendation[]
  tbl_program_competency    tbl_program_competency[]
  tbl_quota                 tbl_quota[]
}

model tbl_program_competency {
  program_id     Int
  competency_id  Int
  weight         Decimal        @db.Decimal(5, 2)
  // Compatibility rule: minimum subject score (%) for this course. Null = no rule.
  min_score      Decimal?       @db.Decimal(5, 2)
  tbl_competency tbl_competency @relation(fields: [competency_id], references: [competency_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_program    tbl_program    @relation(fields: [program_id], references: [program_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([program_id, competency_id])
}

model tbl_question_response {
  result_id         Int
  question_id       Int
  selected_answer   String?           @db.VarChar(255)
  is_correct        Boolean?
  points_earned     Int?
  tbl_exam_question tbl_exam_question @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_exam_result   tbl_exam_result   @relation(fields: [result_id], references: [result_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([result_id, question_id])
}

model tbl_quota {
  quota_id            Int                  @id @default(autoincrement())
  branch_id           Int?
  program_id          Int?
  cycle_id            Int?
  updated_by          Int?
  quota_scope         String?              @db.VarChar(50)
  quota_slots         Int
  tbl_branch          tbl_branch?          @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_admission_cycle tbl_admission_cycle? @relation(fields: [cycle_id], references: [cycle_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_program         tbl_program?         @relation(fields: [program_id], references: [program_id], onDelete: NoAction, onUpdate: NoAction)
  tbl_user_account    tbl_user_account?    @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model tbl_role {
  role_id             Int                   @id @default(autoincrement())
  role_name           String                @unique @db.VarChar(100)
  // Editable label shown in the app (role_name is the fixed code). Null = default label.
  display_name        String?               @db.VarChar(100)
  description         String?
  tbl_role_permission tbl_role_permission[]
  tbl_user_account    tbl_user_account[]
}

model tbl_role_permission {
  role_id        Int
  permission_id  Int
  tbl_permission tbl_permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_role       tbl_role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model tbl_school {
  school_id         Int               @id @default(autoincrement())
  school_name       String            @db.VarChar(150)
  school_type       String?           @db.VarChar(50)
  city_municipality String?           @db.VarChar(100)
  tbl_application   tbl_application[]
}

model tbl_user_account {
  user_id                    Int                          @id @default(autoincrement())
  role_id                    Int?
  username                   String                       @unique @db.VarChar(100)
  password_hash              String                       @db.VarChar(255)
  full_name                  String                       @db.VarChar(150)
  email                      String                       @db.VarChar(150)
  is_active                  Boolean?                     @default(true)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  tbl_import_batch           tbl_import_batch[]
  tbl_passing_score_setting  tbl_passing_score_setting[]
  tbl_quota                  tbl_quota[]
  tbl_application_stage_log  tbl_application_stage_log[]
  tbl_application_document   tbl_application_document[]
  tbl_exam_session           tbl_exam_session[]
  tbl_exam_session_applicant tbl_exam_session_applicant[]
  archived_applicants        tbl_applicant[]              @relation("applicant_archived_by")
  recommendation_settings    tbl_recommendation_setting[]
  tbl_role                   tbl_role?                    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}

// Supporting documents uploaded with an application (Form 138, PSA birth
// certificate). One file per document type per application; re-uploading
// replaces it.
model tbl_application_document {
  document_id      Int               @id @default(autoincrement())
  application_id   Int
  uploaded_by      Int?
  document_type    String            @db.VarChar(50)
  file_name        String            @db.VarChar(255)
  mime_type        String            @db.VarChar(100)
  file_size        Int
  file_data        Bytes
  uploaded_at      DateTime          @default(now()) @db.Timestamp(6)
  tbl_application  tbl_application   @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_user_account tbl_user_account? @relation(fields: [uploaded_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([application_id, document_type])
}

// Exam sitting: one date/venue/room with a seat capacity (Exam Schedule page).
model tbl_exam_session {
  session_id                 Int                          @id @default(autoincrement())
  exam_id                    Int
  session_date               DateTime                     @db.Date
  start_time                 String?                      @db.VarChar(5)
  venue                      String                       @db.VarChar(150)
  room                       String?                      @db.VarChar(50)
  capacity                   Int
  created_by                 Int?
  created_at                 DateTime                     @default(now()) @db.Timestamp(6)
  tbl_exam                   tbl_exam                     @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_user_account           tbl_user_account?            @relation(fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)
  tbl_exam_session_applicant tbl_exam_session_applicant[]
}

// Seat in an exam session. An application sits in at most one session.
// attendance: PRESENT | ABSENT | null (not marked yet).
model tbl_exam_session_applicant {
  session_id       Int
  application_id   Int               @unique
  attendance       String?           @db.VarChar(20)
  marked_by        Int?
  marked_at        DateTime?         @db.Timestamp(6)
  tbl_exam_session tbl_exam_session  @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_application  tbl_application   @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_user_account tbl_user_account? @relation(fields: [marked_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)

  @@id([session_id, application_id])
}

// Per-subject (competency) score typed or imported on the Exam Scores page.
// Takes precedence over question responses for course recommendations.
model tbl_exam_subject_score {
  result_id       Int
  competency_id   Int
  score           Int
  max_score       Int
  tbl_exam_result tbl_exam_result @relation(fields: [result_id], references: [result_id], onDelete: Cascade, onUpdate: NoAction)
  tbl_competency  tbl_competency  @relation(fields: [competency_id], references: [competency_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([result_id, competency_id])
}

// Course Recommendation settings (single row; the first row is used).
// is_enabled = false stops all generation (button, exam score saves, mapping saves).
model tbl_recommendation_setting {
  setting_id       Int               @id @default(autoincrement())
  is_enabled       Boolean           @default(true)
  updated_by       Int?
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  tbl_user_account tbl_user_account? @relation(fields: [updated_by], references: [user_id], onDelete: SetNull, onUpdate: Cascade)
}
